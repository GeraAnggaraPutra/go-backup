DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=test
# Comma-separated list of tables to back up, or empty for all tables
DB_TABLES=table1,table2
OUTPUT_FILE=backup.zip
# Empty string means no schedule, otherwise use cron format
SCHEDULE="0 0 * * *"

# Telegram bot configuration for notifications
TELEGRAM_ENABLED=true
TELEGRAM_TOKEN=123456789:ABCDefghIJKLmn-Opqrst
TELEGRAM_CHAT_ID=987654321

# Google Cloud Storage configuration for uploading backups
GCS_ENABLED=true
GCS_BUCKET_NAME=my-backup-bucket
GCS_SERVICE_ACCOUNT_FILE=./credentials/gcs-service-account.json